int main() {
	int t;
	cin>>t;
	while(t--){
	    int a,b,p,q,r;
	    cin>>a>>b>>p>>q>>r;
	    //target a,b start 0,0
	    vector<vector<int>>dp(a+1,vector<int>(b+1,-1));
	    int ans= solve(a,b,p,q,r,dp);
	    cout<<ans<<endl;
	}
	return 0;

}
