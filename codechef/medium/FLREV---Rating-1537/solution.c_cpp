#include <bits/stdc++.h>
using namespace std;
int solve(string& s){
    int n=s.size();
    
    int beauty=0;
    int cnt01=0;
    int cnt10=0;
    
    bool improve=false;
    // bool improve2=false;
    
    
    for(int i=0;i<n-1;i++){
        if(s[i]==s[i+1]){
            beauty++;
        }else{
            if(s[i]=='0' && s[i+1]=='1') cnt01++;
            else cnt10++;
        }
        
        // if(cnt01 >=2 || cnt10>=2) improve2=true;
        
        if(s[i]!=s[i+1] && s[i+1]==s[0]) improve=true;
        if(s[i+1]!=s[i] && s[n-1]==s[i]) improve=true;
    }
    if(cnt01 >=2 || cnt10>=2) return beauty+2;
    if(improve){
        return beauty+1;
    }
    return beauty;
}
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    string s;
	    cin>>n;
	    cin>>s;
	    int ans=solve(s);
	    cout<<ans<<endl;
	    
	}
    return 0;
}
